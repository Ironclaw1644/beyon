# Names only. Copy to .env.local and fill in values locally or in the host's env settings.

# Site
NEXT_PUBLIC_SITE_URL=

# Supabase (schema `beyon`, service role only)
CMS_SUPABASE_URL=
CMS_SUPABASE_SERVICE_ROLE_KEY=
# Accepted fallbacks if the CMS_* names are not set
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional; the only allowed value is beyon
CMS_SCHEMA=

# Admin login
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Development only (ignored when NODE_ENV=production)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
# Admin inbox (Resend Inbound): full-access key, email.received webhook secret,
# optional Gmail copy (leave unset while ImprovMX already forwards to Gmail)
RESEND_INBOUND_API_KEY=
RESEND_INBOUND_WEBHOOK_SECRET=
FORWARD_INBOUND_TO=
EMAIL_TOKEN_SECRET=

# Scheduled jobs and diagnostics
CRON_SECRET=
DEBUG_TOKEN=
ADMIN_ALLOWLIST=

# Optional LeadOps forwarding
LEADOPS_API_ROUTE=
LEADOPS_TOKEN=
LEADOPS_SOURCE=
LEADOPS_INGEST_KEY=
LEADOPS_SOURCE_PROJECT=
LEADOPS_SOURCE_CHANNEL=
